# Set only in this project's environment; do not modify the original site or form settings.
# The owner explicitly authorized this new site's reuse of the existing delivery endpoint.
CONTACT_FORM_ENDPOINT=
# Set automatically when a PRIVATE Vercel Blob store is connected to this project.
# Keep this server-only value out of Git and NEXT_PUBLIC_ variables.
BLOB_READ_WRITE_TOKEN=
# /admin sign-in password. Required for the admin dashboard; server-only, never commit it.
ADMIN_PASSWORD=
# Optional separate secret for signing admin session cookies; falls back to ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=
